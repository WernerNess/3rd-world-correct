      motto: 'Leading the vision',
      initials: 'MR'
    },
    {
      name: 'WERNER NESS',
      role: 'OWNER',
      motto: 'Building the future',
      initials: 'WN'
    },
    {
      name: 'ZACHARY DELANE',
      role: 'OWNER',
      motto: 'Creating the experience',
      initials: 'ZD'
    },
    {
      name: 'ELIZABETH NESS',
      role: 'OWNER',
      motto: 'Driving excellence',
      initials: 'EN'
    },
    {
      name: 'CAT REIGN',
      role: 'OWNER',
      motto: 'Shaping the journey',
      initials: 'CR'
    }
